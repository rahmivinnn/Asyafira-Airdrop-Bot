# Simple Zealy.io Task Claimer Configuration

# Required: Cookie from your browser session
# Get this by logging into zealy.io, opening Developer Tools (F12),
# go to Application/Storage > Cookies, and copy the cookie string
COOKIE=your_session_cookie_here

# Optional: Specific task URL (will auto-extract from cookie if not provided)
TASK_URL=https://zealy.io/api/claim

# Optional: HTTP method (default: POST)
HTTP_METHOD=POST

# Optional: JSON payload for POST requests
JSON_PAYLOAD={"action":"claim"}

# Optional: Telegram notifications
TELEGRAM_TOKEN=your_bot_token_here
CHAT_ID=your_chat_id_here